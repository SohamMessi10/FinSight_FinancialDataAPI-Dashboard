# FastAPI backend image. Built from the repo root (see docker-compose.yml)
# so it can copy both requirements.txt and app/.
FROM python:3.11-slim

WORKDIR /app

RUN groupadd -r finsight && useradd -r -g finsight -d /app finsight

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app/ ./app

RUN chown -R finsight:finsight /app
USER finsight

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
