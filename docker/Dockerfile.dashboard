# Streamlit dashboard image. Built from the repo root (see docker-compose.yml)
# so it can copy both requirements.txt and dashboard/.
FROM python:3.11-slim

WORKDIR /app

RUN groupadd -r finsight && useradd -r -g finsight -d /app finsight

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY dashboard/ ./dashboard

RUN chown -R finsight:finsight /app
USER finsight

EXPOSE 8501

CMD ["streamlit", "run", "dashboard/streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8501"]
